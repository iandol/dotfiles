	sudo printf "\n=====>>> Start Update @ \e[93m$(date)\e[m <<<=====\n"
	myolddir=$(pwd)
	ul=(~/.dotfiles ~/Code/opticka ~/Code/octicka ~/Code/Titta ~/Code/Pingpong
	~/Code/CageLab-Code ~/Code/matmoteGO ~/Code/PTBSimia ~/Code/Notes 

# open a list of ssh servers in separate kitty tabs
sshTab() {
	tool=tssh
	while [ "$#" -gt 0 ]; do
		case "$1" in
			-t|--tool)
				if [ "$#" -lt 2 ]; then
					echo "Usage: sshTab [-t tool] host [...]" >&2
					return 1
				fi
				tool=$2
				shift 2
				;;
			--tool=*)
				tool=${1#*=}
				shift
				;;
			--)
				shift
				break
				;;
			-*)
				echo "Unknown option: $1" >&2
				return 1
				;;
			*)
				break
				;;
		esac
	done

	if [ "$#" -eq 0 ]; then
		echo "Usage: sshTab [-t tool] host [...]" >&2
		return 1
	fi

	for h in "$@"; do
		case "$tool" in
			mosh)
				echo "Opening MOSH tab to $h"
				if command -v kitty >/dev/null 2>&1; then
					kitty @ launch --type tab --tab-title "$h" "$(command -v mosh)" "$h"
				else
					mosh "$h"
				fi
				;;
			tssh)
				echo "Opening TSSH tab to $h"
				if command -v kitty >/dev/null 2>&1; then
					kitty @ launch --type tab --tab-title "$h" -- "$(command -v tssh)" --udp "$h"
				else
					tssh --udp "$h"
				fi
				;;
			ssh)
				echo "Opening SSH tab to $h"
				if command -v kitty >/dev/null 2>&1; then
					kitty @ launch --type tab --tab-title "$h" kitten ssh "$h" --kitten login_shell=elvish
				else
					ssh "$h"
				fi
				;;
			*)
				echo "Unsupported tool: $tool" >&2
				return 1
				;;
		esac
	done
}


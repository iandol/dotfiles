	~/Code/scrivomatic ~/Code/dotpandoc ~/Code/bookends-tools ~/Code/pandocomatic 
	~/Code/gears ~/Code/paru 
	"/media/$USER/data/Code/octicka" "/media/$USER/data/Code/Psychtoolbox-3")
	for x in "${ul[@]}"; do
		if [[ -d ${x}/.git ]]; then
			printf "\n\n---> Updating \e[92m%s\e[m...\n" "${x}"
			cd "${x}" || exit
			oldbranch=$(git branch | grep -e '\*' | cut -b 3-)

			# Check for local changes and stash if needed
			stashed=false
			if [[ -n $(git status --porcelain) ]]; then
				printf "\t\t---> Found local changes in \e[93m%s\e[m, stashing...\n" "${x}"
				git stash save "Auto-stashed by update function $(date)"
				stashed=true
				printf "\t\t---> Changes stashed. Use 'git stash list/pop' to recover\n"
			fi

			if [[ ! ${oldbranch} =~ master\|main ]]; then
				if [[ ${x} =~ fieldtrip ]]; then
					git checkout umaster
				elif [[ ${x} =~ Palamedes ]]; then
					git checkout main
				else
					git checkout master
				fi
			fi
			git pull
			git status
			if git remote 2>/dev/null | grep -q upstream; then
				printf "\t\t---> Fetching \e[92m%s\e[m upstream...\n" "${x}"
				git fetch -v upstream
				if [[ ! ${x} =~ Psychtoolbox ]]; then
					git merge --ff-only -v upstream/master
				fi
			fi
			if [[ ! ${oldbranch} =~ 'master' ]]; then
				git checkout "${oldbranch}"
			fi

			# Pop stashed changes after updating
			if [[ "$stashed" == true ]]; then
				printf "\t\t---> Restoring stashed changes in \e[93m%s\e[m...\n" "${x}"
				if ! git stash pop; then
					printf "\t\t---> WARNING: Could not pop stash. Please resolve manually.\n"
				fi
			fi
		fi
	done
	cd "$myolddir" 
	unset myolddir

	if [[ -x $(which brew) ]]; then
		printf '\n\n---> Updating \e[92mHomeBrew\e[m...\n'
		export HOMEBREW_NO_BOTTLE_SOURCE_FALLBACK='true'
		brew update; brew outdated; brew upgrade --yes --display-times; brew cleanup --prune=2
	fi

	if [[ $PLATFORM = "Linux" ]]; then
		printf '\n\n---> Updating \e[92mApt/snap/flatpak/firmware\e[m...\n'
		sudo apt update; sudo apt autoremove; apt list --upgradable
		[[ -x $(which snap) ]] && sudo snap refresh
		[[ -x $(which flatpak) ]] && flatpak update -y
		[[ -x $(which fwupdmgr) ]] && fwupdmgr get-upgrades
	fi

	[[ -f $(which pixi) ]] && (printf '\n\n---> Updating \e[92mPIXI\e[m...\n'; pixi self-update; pixi global -v update)
	[[ -f $(which ya) ]] && (printf '\n\n---> Updating \e[92mYAZI\e[m...\n'; ya pkg upgrade)
	[[ -d "$HOME/.local/share/znap" ]] && (printf '\n\n---> Updating \e[92mZNAP\e[m...\n'; znap pull)
	[[ -e "$HOME/.x-cmd.root/bin/x-cmd" ]] &&  (printf '\n\n---> Updating \e[92mX-CMD\e[m...\n'; x-cmd upgrade; x-cmd update; x-cmd env upgrade --all --force)
	printf "\n=====>>> Finish Update @ \e[93m%s\e[m <<<=====\n" "$(date)"
}

#============================================Elvish
# Identify the published build before pulling ~6MB: the mirror serves a sha256
# sidecar for the binary and for the archive, and the archive's Last-Modified
# date is the UTC build time baked into `elvish -version`
# (0.22.0-dev.0.20250308121232-...). An identical hash means the installed
# binary *is* the published build, so nothing is downloaded.
#   updateElvish                      # install only when the build changed
#   updateElvish --check              # report local vs remote, change nothing
#   updateElvish --force              # reinstall even if byte-identical
#   updateElvish --version v0.21.0    # pin a released tag instead of HEAD
#   updateElvish --source dl|tuna|URL # choose the mirror (tuna falls back to dl)
function _sha256() {
	if command -v sha256sum >/dev/null 2>&1; then
		command sha256sum "$1" | awk '{print $1}'
	elif command -v shasum >/dev/null 2>&1; then
		command shasum -a 256 "$1" | awk '{print $1}'
	fi
}

# shellcheck disable=SC2120 # called with options by hand, bare from updateAll
function updateElvish() {
	local ver=HEAD src=tuna check=0 force=0
	while [ $# -gt 0 ]; do
		case "$1" in
			-c|--check) check=1 ;;
			-f|--force) force=1 ;;
			-v|--version) ver=$2; shift ;;
			-s|--source) src=$2; shift ;;
			-h|--help)
				printf 'usage: updateElvish [--check] [--force] [--version TAG] [--source tuna|dl|URL]\n'
				return 0 ;;
			*)
				printf 'updateElvish: unknown option %s\n' "$1" >&2
				return 2 ;;
		esac
		shift
	done

	local os=linux arch=amd64
	[ "$PLATFORM" = 'Darwin' ] && os=darwin
	case "$(uname -m)" in
		arm64|aarch64) arch=arm64 ;;
	esac
	local art="elvish-$ver.tar.gz"
	local bindir=/usr/local/bin/elvish

	local -a bases
	case "$src" in
		dl) bases=("https://dl.elv.sh/$os-$arch") ;;
		tuna) bases=("https://mirrors.tuna.tsinghua.edu.cn/elvish/$os-$arch" "https://dl.elv.sh/$os-$arch") ;;
		*) bases=("$src") ;;
	esac

	local oldver='' oldsha=''
	if [ -f "$bindir" ]; then
		oldver=$("$bindir" -version 2>/dev/null)
		oldsha=$(_sha256 "$bindir")
	fi
	printf '\n---> ELVISH %s · %s-%s\n' "$ver" "$os" "$arch"
	if [ -n "$oldver" ]; then
		printf '	installed: %s · sha256 %.12s…\n' "$oldver" "$oldsha"
	else
		printf '	installed: none (%s)\n' "$bindir"
	fi

	# probe every mirror: two tiny requests, no archive download
	local base='' rbin='' b hdr code lmt bh
	for b in "${bases[@]}"; do
		hdr=$(curl -sSIL --max-time 20 "$b/$art" 2>&1 | tr -d '\r')
		code=$(printf '%s\n' "$hdr" | awk '/^HTTP\//{c=$2} END{print c+0}')
		lmt=$(printf '%s\n' "$hdr" | grep -i '^last-modified:' | tail -n 1 | sed 's/^[^:]*:[[:space:]]*//')
		bh=$(curl -fsSL --max-time 20 "$b/elvish-$ver.sha256sum" 2>/dev/null | grep -oE '[0-9a-f]{64}' | head -n 1)
		printf '	probe: %s → HTTP %03d · built %s · sha256 %.12s…\n' \
			"$b" "$code" "${lmt:-(unknown)}" "${bh:-(none)}"
		if [ "$code" = 200 ]; then
			base=$b; rbin=$bh
			break
		fi
	done
	if [ -z "$base" ]; then
		printf '	✗ no mirror served %s — aborting\n' "$art" >&2
		return 1
	fi
	if [ "$base" != "https://dl.elv.sh/$os-$arch" ]; then
		hdr=$(curl -sSIL --max-time 20 "https://dl.elv.sh/$os-$arch/$art" 2>&1 | tr -d '\r')
		lmt=$(printf '%s\n' "$hdr" | grep -i '^last-modified:' | tail -n 1 | sed 's/^[^:]*:[[:space:]]*//')
		[ -n "$lmt" ] && printf '	upstream dl.elv.sh built %s\n' "$lmt"
	fi

	# is the published build the one already installed?
	local same=0
	if [ -n "$rbin" ] && [ "$rbin" = "$oldsha" ]; then
		same=1
	elif [ -z "$rbin" ] && [ -n "$oldver" ] && [ "$ver" != HEAD ]; then
		case "$oldver" in "${ver#v}"*) same=1 ;; esac
	fi
	if [ $same -eq 1 ]; then
		printf '	✔ up to date — installed binary is byte-identical to the published build\n'
	elif [ "$ver" = HEAD ]; then
		printf '	⬆ newer build published — update available\n'
	else
		printf '	≢ installed is not %s — update available\n' "$ver"
	fi
	[ $check -eq 1 ] && return 0
	[ $same -eq 1 ] && [ $force -eq 0 ] && return 0

	# download, verify, install
	local -a tryl
	tryl=("$base")
	for b in "${bases[@]}"; do
		[ "$b" = "$base" ] || tryl+=("$b")
	done
	local tmp ok=0 want got newver newsha
	tmp=$(mktemp -d "${TMPDIR:-/tmp}/elvish.XXXXXX") || return 1
	for b in "${tryl[@]}"; do
		[ $ok -eq 1 ] && break
		printf '\n---> GET %s/%s\n' "$b" "$art"
		if ! curl -fsSL --max-time 300 -o "$tmp/$art" "$b/$art"; then
			printf '	✗ download failed from %s\n' "$b" >&2
			continue
		fi
		want=$(curl -fsSL --max-time 20 "$b/$art.sha256sum" 2>/dev/null | grep -oE '[0-9a-f]{64}' | head -n 1)
		got=$(_sha256 "$tmp/$art")
		if [ -n "$want" ] && [ "$got" != "$want" ]; then
			printf '	✗ archive sha256 mismatch (want %s, got %s)\n' "$want" "$got" >&2
			continue
		fi
		printf '	archive sha256 verified %.12s…\n' "$got"
		if ! tar xzf "$tmp/$art" -C "$tmp" || [ ! -f "$tmp/elvish" ]; then
			printf '	✗ no elvish binary in the archive\n' >&2
			continue
		fi
		if ! {
			sudo mkdir -p "$(dirname "$bindir")" &&
				sudo rm -f "$bindir" &&
				sudo cp "$tmp/elvish" "$bindir" &&
				sudo chown "${USER:-$(id -un)}" "$bindir" &&
				sudo chmod +x "$bindir"
		}; then
			printf '	✗ install failed (sudo?)\n' >&2
			continue
		fi
		newver=$("$bindir" -version 2>/dev/null)
		newsha=$(_sha256 "$bindir")
		if [ -n "$rbin" ] && [ "$newsha" != "$rbin" ]; then
			printf '	⚠ installed binary does not match the published sha256!\n' >&2
		fi
		printf '\n===UPDATED===\nOld: %s\nNew: %s\n' "${oldver:-(none)}" "$newver"
		ok=1
	done
	rm -rf "$tmp"
	[ $ok -eq 1 ] || printf '	ELVISH was not updated\n' >&2
	return 0
}

function doBib() {
	myolddir=$(pwd); cd ~/Desktop || return
	if [[ $# -eq 0 ]]; then
		[[ -f "🌊Core.bib" ]] && mv 🌊Core.bib Core.bib
		filename="Core.bib"
	else
		filename=$1
	fi
	printf "\n---> Processing Bibliography file $filename @ \e[93m$(date)\e[m...\n"
	if [[ ! -f $filename ]]; then
		printf "\nCannot find $filename\n"
		return -1
	fi
	printf '\n---> Citeproc generating JSON from BIB file...\n'
	pandoc -f biblatex -t csljson $filename > Temp.json
	printf '\n---> Processing title case...\n'
	unset PIDS names i
	names=($filename Temp.json)
	i=1
	for x in $names; do
		fixCase.rb ${x} &
		p=$!; PIDS[$i]=$p
		printf "fixCase for %s - Loop: %i PID = %i\n" $x $i ${PIDS[$i]:-"Unknown"}
		((i++)) #https://linuxize.com/post/bash-increment-decrement-variable/
	done
	echo "Waiting for PIDS: ${PIDS[*]}"
	wait "${PIDS[@]}"
	echo "Finshed processing title case"
	printf '\n---> Minifying JSON...\n'
	[[ -f Temp.json ]] && jq -c . < Temp.json > Core.json
	printf '\n---> Moving to Dropbox...\n'
	mv -v Core.* ~/Dropbox/Papers/References
	rm -v Temp.json
	printf '\n---> ...Finished!\n'
	cd $myolddir; unset filename myolddir
}


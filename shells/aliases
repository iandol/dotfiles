		sudo systemctl stop avahi-daemon.socket
		sudo systemctl stop avahi-daemon.service
		sudo systemctl status avahi-daemon.service
	fi
}

#============================================Transfer files
# Upload files and print their public URL.
#   transfer shot.png             # uguu.se: direct GET link, kept ~3 hours
#   cat file | transfer name.txt  # upload stdin under a name
# transfer.sh was retired in 2024, so its upload endpoint is gone.
function transfer() {
	if [ $# -eq 0 ]; then
		printf 'transfer — upload files and print their public URLs\n'
		printf '  usage: transfer <file> [<file> ...]\n'
		printf '         cat file | transfer <name>\n'
		printf '  backend: https://uguu.se (direct link, works with curl, kept ~3 hours)\n'
		return 1
	fi
	local f url
	for f in "$@"; do
		if [ -f "$f" ]; then
			url=$(curl -sS --max-time 300 -F "files[]=@${f}" 'https://uguu.se/upload?output=text') || url=''
		elif [ ! -t 0 ]; then
			url=$(curl -sS --max-time 300 -F "files[]=@-;filename=$(basename "$f")" \
				'https://uguu.se/upload?output=text') || url=''
		else
			printf 'transfer: not a file: %s\n' "$f" >&2
			continue
		fi
		case "$url" in
			https://*) printf '%s -> %s\n' "$f" "$url" ;;
			*) printf 'transfer: upload failed for %s: %s\n' "$f" "$url" >&2 ;;
		esac
	done
}

#============================================Cl1p service
# cl1p <content> <name> -- POST text to cl1p.net so it can be read back with
# `curl https://api.cl1p.net/<name>` or in a browser at https://cl1p.net/<name>.
# The API token is read from ~/.cl1papitoken.
function cl1p() {
	if [ $# -ne 2 ]; then
		printf 'cl1p — share text through cl1p.net\n'
		printf '  usage: cl1p "the text to share" mynote\n'
		printf '         curl https://api.cl1p.net/mynote    # read it back\n'
		printf '         https://cl1p.net/mynote             # …or open it in a browser\n'
		printf '  token: ~/.cl1papitoken (sent as the cl1papitoken header)\n'
		return 1
	fi
	if [ ! -f ~/.cl1papitoken ]; then
		printf 'cl1p: no API token at ~/.cl1papitoken — create one at cl1p.net first\n' >&2
		return 1
	fi
	# command cat: this file aliases cat to bat when it is installed
	local key response
	key=$(command cat ~/.cl1papitoken)
	response=$(curl -sS -H "Content-Type: text/html; charset=UTF-8" \
		-H "cl1papitoken: $key" -X POST --data "$1" "https://api.cl1p.net/$2") || return 1
	[ -n "$response" ] && printf '%s\n' "$response"
	printf 'Read data using `curl https://api.cl1p.net/%s`\n' "$2"
}

function sp() {

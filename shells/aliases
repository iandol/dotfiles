#==================================================== - How to reset a Linux clone
function cloneReset () { 
	# This function resets the machine ID and hostname for a Linux clone. It
	# is useful when you clone a VM or a machine and want to avoid conflicts
	# with the original machine. It will also reset the SSH host keys and
	# prompt how to add a new profile in netbird. 
	#
	# Usage: cloneReset <new-hostname> 
	# Example: cloneReset my-new-hostname 
	#
	# https://gist.github.com/iandol/85f663cf670cb3b94ea1b661757bb356
	[[ -z $1 ]] && return 1
	hostname=$1
	hostnamectl
	echo "Old Machine ID: $(cat /etc/machine-id) Old Hostname: $(cat /etc/hostname)"
	sudo rm -f /etc/machine-id /var/lib/dbus/machine-id
	sudo dbus-uuidgen --ensure=/etc/machine-id
	hostnamectl set-hostname $hostname
	sudo sed -i.bak -E 's/^[[:space:]]*127\.0\.1\.1.*/127.0.1.1 '"$hostname"'/' /etc/hosts
	echo "New Machine ID: $(cat /etc/machine-id) NewHostname: $(cat /etc/hostname)"
	sudo rm -f /etc/ssh/ssh_host_*
	sudo dpkg-reconfigure openssh-server
	sudo systemctl restart ssh
	echo "For netbird, you must [netbird profile add newprofile] and then [netbird profile select] it"
}

#============================================FFMPEG
# Static builds from ffmpeg.martin-riedl.de (replaces the evermeet.cx updater,
# which was macOS-only, snapshot-only and needed 7z). The documented script
# URLs are  …/redirect/latest/<os>/<arch>/<channel>/<tool>.zip  and answer 307
# pointing at an immutable build directory that carries the build id:
#   …/download/linux/amd64/1789931100_9.0.2/ffmpeg.zip
# so the remote build is identified with one bodiless request instead of
# pulling ~100MB of zips; every file also has a .sha256 sidecar that is
# verified before anything is installed.
# Two quirks: the /redirect/ endpoint answers 404 to a HEAD (the probe must be a
# GET with the body thrown away), and the binaries report a suffixed version
# (`9.0.2-https://www.martin-riedl.de`, snapshots `<branch>.git-<url>`), so the
# build id is remembered in $dest/.ffmpeg-build.
#   updateFFMPEG                     # release channel (default)
#   updateFFMPEG --channel=snapshot
#   updateFFMPEG --check             # report local vs remote, change nothing
#   updateFFMPEG --force             # reinstall even if the build matches
# shellcheck disable=SC2120 # called with options by hand, bare from updateAll
function updateFFMPEG() {
	local channel=release check=0 force=0
	while [ $# -gt 0 ]; do
		case "$1" in
			-c|--check) check=1 ;;
			-f|--force) force=1 ;;
			--channel=*) channel=${1#*=} ;;
			--channel) channel=$2; shift ;;
			-h|--help)
				printf 'usage: updateFFMPEG [--check] [--force] [--channel=release|snapshot]\n'
				return 0 ;;
			*)
				printf 'updateFFMPEG: unknown option %s\n' "$1" >&2
				return 2 ;;
		esac
		shift
	done

	local os arch
	[ "$PLATFORM" = 'Darwin' ] && os=macos || os=linux
	case "$PROC" in
		arm64|aarch64) arch=arm64 ;;
		*) arch=amd64 ;;
	esac
	local dest=/usr/local/bin
	local url="https://ffmpeg.martin-riedl.de/redirect/latest/$os/$arch/$channel/ffmpeg.zip"
	printf '\n---> FFMPEG %s · %s-%s\n' "$channel" "$os" "$arch"

	# --- remote build id: one redirect, no payload ---
	local target dir build ver
	target=$(curl -sS --max-time 30 -o /dev/null -w '%{redirect_url}' "$url") || target=''
	if [ -z "$target" ]; then
		printf '	✗ cannot resolve %s — no %s build for %s-%s?\n' "$url" "$channel" "$os" "$arch" >&2
		return 1
	fi
	dir=$(dirname "$target")
	build=$(basename "$dir")
	ver=${build#*_}
	case "$build" in
		[0-9]*_*) : ;;
		*)
			printf '	✗ unexpected redirect target: %s\n' "$target" >&2
			return 1 ;;
	esac

	# --- what is installed? ---
	local bin=$dest/ffmpeg localver='' marker=$dest/.ffmpeg-build seen=''
	if [ -f "$bin" ]; then
		localver=$("$bin" -version 2>/dev/null | head -n 1 | sed -nE 's/^ffmpeg version ([^ ]+).*/\1/p')
	fi
	[ -f "$marker" ] && seen=$(head -n 1 "$marker" | tr -d '[:space:]')
	printf '	remote: %s (build %s)\n' "$ver" "$build"
	printf '	local : %s\n' "${localver:-not installed}"

	# --- already there? build id first, version string as a fallback ---
	local same=0
	if [ "$seen" = "$build" ]; then
		same=1
	elif [ -n "$localver" ]; then
		case "$localver" in "$ver"*) same=1 ;; esac
	fi
	if [ $same -eq 1 ]; then
		printf '	✔ up to date — installed build is %s\n' "$build"
	else
		printf '	⬆ newer build available\n'
	fi
	[ $check -eq 1 ] && return 0
	[ $same -eq 1 ] && [ $force -eq 0 ] && return 0

	# --- download, verify, install ---
	local tmp ok=0 t zurl want got
	tmp=$(mktemp -d "${TMPDIR:-/tmp}/ffmpeg.XXXXXX") || return 1
	for t in ffmpeg ffprobe ffplay; do
		zurl=$dir/$t.zip
		printf '\n---> GET %s\n	%s\n' "$t.zip" "$zurl"
		if ! curl -fsSL --max-time 300 -o "$tmp/$t.zip" "$zurl"; then
			printf '	✗ download failed\n' >&2
			continue
		fi
		want=$(curl -fsSL --max-time 30 "$zurl.sha256" 2>/dev/null | grep -oE '[0-9a-f]{64}' | head -n 1)
		got=$(_sha256 "$tmp/$t.zip")
		if [ -n "$want" ] && [ "$got" != "$want" ]; then
			printf '	✗ %s sha256 mismatch (want %s, got %s)\n' "$t.zip" "$want" "$got" >&2
			continue
		fi
		printf '	%s sha256 verified %.12s…\n' "$t.zip" "$got"
		if ! { unzip -oq "$tmp/$t.zip" -d "$dest" 2>/dev/null || sudo unzip -oq "$tmp/$t.zip" -d "$dest"; }; then
			printf '	✗ unzip failed for %s\n' "$t" >&2
			continue
		fi
		ok=$((ok + 1))
	done

	if [ $ok -eq 3 ]; then
		printf '%s\n' "$build" > "$tmp/marker"
		mv -f "$tmp/marker" "$marker" 2>/dev/null || sudo mv -f "$tmp/marker" "$marker"
		# kept from the old evermeet updater: some GUI apps look here
		if [ "$PLATFORM" = 'Darwin' ] && [ -d "$HOME/Library/Application Support/FFmpegTools" ]; then
			cp -f "$dest/ffmpeg" "$dest/ffprobe" "$HOME/Library/Application Support/FFmpegTools/" 2>/dev/null
		fi
		local newver
		newver=$("$bin" -version 2>/dev/null | head -n 1 | sed -nE 's/^ffmpeg version ([^ ]+).*/\1/p')
		printf '\n===UPDATED===\nOld: %s\nNew: %s\n' "${localver:-(none)}" "${newver:-(unknown)}"
	else
		printf '	✗ only %s of 3 tools were installed\n' "$ok" >&2
	fi
	rm -rf "$tmp"
}


# sway config file
#
# Modernised from the i3 config in this repo (see i3config) for sway 1.11.
# Reference: man 5 sway, man 5 sway-input, man 5 sway-output, man 5 sway-bar,
# man 1 swaynag, man 1 swaymsg.
#
# Linked to ~/.config/sway/config by rotz (tiling/dot.yaml).

set $mod Mod4

# Font for window titles (focused window's title bar).  The bar sets its own.
font pango:Alegreya Sans 13

# Pull in per-machine overrides if the directory exists (e.g. output names,
# input devices, touchpad settings).  Not managed by dotfiles.
include ~/.config/sway/config.d/*

### Autostart ################################################################

# Run XDG autostart .desktop entries, filtered on XDG_CURRENT_DESKTOP=sway.
# (i3 used `--environment i3`; dex matches OnlyShowIn= against this value.)
exec dex --autostart --environment sway

# gnome-keyring is now a systemd user service on this machine
# (gnome-keyring-daemon.service/.socket are enabled), so starting the daemon
# by hand here would create a second, unmanaged instance.  Check with:
#   systemctl --user status gnome-keyring-daemon.service

# nm-applet and blueman-applet are XEmbed (GtkStatusIcon) tray applets.
# swaybar's tray only implements StatusNotifierItem, so they would run but
# never show an icon.  Prefer nmcli / nmtui, or a StatusNotifier applet.
# exec nm-applet
# exec blueman-applet

### Wallpaper ################################################################

# Native wallpaper handling (swaybg), replaces feh/nitrogen/X cursor tools.
output * bg ~/.dotfiles/terminals/everforest.jpg fill

### Appearance ###############################################################

# Configure space between windows and to the screen edges.
gaps inner 5
gaps outer 0

# No borders/title bar when a workspace holds a single window; this is the
# sway equivalent of i3's `hide_edge_borders smart_no_gaps` (outer gaps are 0).
smart_borders on

default_border normal 2
default_floating_border normal 2
titlebar_border_thickness 1

# i3-only window/workspace behaviours that do have sway equivalents:
workspace_auto_back_and_forth yes

# Xwayland is required for MATLAB / Psychtoolbox and other X11-only tools.
xwayland enable

### Input ####################################################################

# Native input configuration; list devices with `swaymsg -t get_inputs`.
# Examples (uncomment and adjust):
#
# input type:keyboard {
#     xkb_layout us
#     xkb_options ctrl:nocaps
#     repeat_delay 300
#     repeat_rate 40
# }
#
# input type:touchpad {
#     tap enabled
#     natural_scroll enabled
#     accel_profile adaptive
# }
#
# seat seat0 hide_cursor 2000        # hide the pointer while typing

### Window tweaks ############################################################

# Criteria: `app_id` matches Wayland clients, `class` matches X11/Xwayland
# clients (MATLAB, xclock, copyq under Xwayland), `title` matches both.
for_window [title="Event Tester"] floating enable
for_window [title="xclock"] floating enable
for_window [title="Bitwarden"] floating enable

for_window [class="copyq"] floating enable
for_window [app_id="copyq"] floating enable

for_window [title="^CageLab"] floating enable
for_window [title="^Alyx"] floating enable
for_window [title="^PTB Onscreen Window"] floating enable
for_window [title="^Figures"] floating enable
for_window [title="^Opticka"] floating enable
for_window [title="^Comments"] floating enable
for_window [class="^Matlab-GLEE"] floating enable

# kitty is a native Wayland client; borderless by default.
for_window [app_id="kitty"] border none
for_window [class="kitty"] border none

# Rofi runs through Xwayland; keep it (and its helper windows) floating.
for_window [class="^Rofi"] floating enable
for_window [app_id="^rofi"] floating enable

### KEYS #####################################################################

# start a terminal
bindsym $mod+Return exec kitty --single-instance -d ~

# toggle border (sway's `border toggle` takes no size argument)
bindsym $mod+Shift+b border toggle

# scratchpad: make the focused window a scratchpad, then show it again
bindsym $mod+Shift+plus move scratchpad
bindsym $mod+plus scratchpad show

# kill focused window
bindsym $mod+Shift+q kill

# launcher
bindsym $mod+Shift+space exec rofi -show combi -modes combi -combi-modes 'window,drun,run'
bindsym $mod+d exec rofi -show combi -modes combi -combi-modes 'window,drun,run'

# show all keybindings in rofi (script auto-detects swaymsg vs i3-msg)
bindsym $mod+F1 exec ~/.dotfiles/bin/i3Keys.py

# change focus
# --to-code makes the binding independent of the active XKB layout, so hjkl
# still work after switching to another keyboard layout.
bindsym --to-code $mod+h focus left
bindsym --to-code $mod+j focus down
bindsym --to-code $mod+k focus up
bindsym --to-code $mod+l focus right

# alternatively, you can use the cursor keys:
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# move focused window
bindsym --to-code $mod+Shift+h move left
bindsym --to-code $mod+Shift+j move down
bindsym --to-code $mod+Shift+k move up
bindsym --to-code $mod+Shift+l move right

# alternatively, you can use the cursor keys:
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# split in horizontal / vertical orientation
bindsym $mod+minus split h
bindsym $mod+backslash split v

# enter fullscreen mode for the focused container
bindsym $mod+Shift+f fullscreen toggle

# change container layout (stacked, tabbed, toggle split)
bindsym $mod+Shift+comma layout toggle tabbed stacking
bindsym $mod+Shift+period floating toggle
bindsym $mod+Shift+slash layout toggle split

# change focus between tiling / floating windows
bindsym $mod+space focus mode_toggle

# focus the parent container
bindsym $mod+a focus parent

# Define names for default workspaces for which we configure key bindings later on.
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# reload the configuration file
bindsym $mod+Shift+c reload

# sway has no in-place restart (`swaymsg restart` is not a command; i3's
# restart has no equivalent).  Reload re-reads this file; to replace the
# compositor binary, exit and log back in.
bindsym $mod+Shift+r reload

# exit sway (ends the Wayland session) - native swaynag prompt
bindsym $mod+Shift+e exec swaynag -f "Alegreya Sans 25" -t warning \
	--background 222222 --border 775528 --text ffffff \
	--button-background 775528 --button-text ffffff \
	-m 'Exit sway? This will end your Wayland session.' \
	-B 'Exit sway' 'swaymsg exit'

### Media keys ###############################################################

# pactl talks to PipeWire through pipewire-pulse.  --locked keeps these
# working while a screen locker is active.  i3status is refreshed explicitly
# so the bar's modules update immediately.  Note the `&&`: it belongs to the
# shell command; a `;` here would end the exec and be parsed by sway.
set $refresh_i3status pkill -USR1 -x i3status
bindsym --locked XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +10% && $refresh_i3status
bindsym --locked XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -10% && $refresh_i3status
bindsym --locked XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle && $refresh_i3status
bindsym --locked XF86AudioMicMute exec pactl set-source-mute @DEFAULT_SOURCE@ toggle && $refresh_i3status

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

# Drag-and-drop tiling windows by their title bar (or Mod4+drag anywhere).
tiling_drag enable

### Modes ####################################################################

# service mode: resizing with h/j/k/l and the arrow keys
mode "service" {
	# split in horizontal / vertical orientation
	bindsym minus split h
	bindsym backslash split v

	# Pressing h shrinks the window's width, l grows it,
	# k shrinks the height, j grows it.
	bindsym h resize shrink width 10 px
	bindsym j resize grow height 10 px
	bindsym k resize shrink height 10 px
	bindsym l resize grow width 10 px

	# same bindings, but for the arrow keys
	bindsym Left resize shrink width 5 px
	bindsym Down resize grow height 5 px
	bindsym Up resize shrink height 5 px
	bindsym Right resize grow width 5 px

	# back to normal: Enter or Escape or $mod+r
	bindsym Return mode "default"
	bindsym Escape mode "default"
	bindsym $mod+r mode "default"
}

bindsym $mod+Shift+z mode "service"

### COLORS ###################################################################

# class                 border  backgr. text    indicator child_border
client.focused          #997844 #775528 #ffffff #fe9e24   #775528
client.focused_inactive #333333 #5f676a #cccccc #484e50   #5f676a
client.unfocused        #333333 #222222 #888888 #292d2e   #222222
client.urgent           #2f343a #900000 #ffffff #900000   #900000
client.placeholder      #000000 #0c0c0c #ffffff #000000   #0c0c0c
client.background       #444444

### Bar ######################################################################

# Native swaybar, fed by i3status (i3bar JSON protocol).  swaybar supports
# `mode hide` + `modifier` natively, so the bar slides away when not in use;
# right-click the bar to pin it.
bar {
	id main
	position bottom
	status_command i3status
	font pango:Alegreya Sans 15
	mode hide
	hidden_state hide
	modifier $mod
	bindsym button3 bar mode toggle
	tray_padding 0
	separator_symbol "☄️"
	workspace_min_width 50
	colors {
		background #111111
		statusline #eeeeee
		separator #aaaaaa
		focused_workspace  #99784c #775528 #ffffff
		active_workspace   #333333 #5f676a #ffffff
		inactive_workspace #333333 #222222 #888888
		urgent_workspace   #2f343a #900000 #ffffff
		binding_mode       #2f343a #999900 #ffffff
	}
}
